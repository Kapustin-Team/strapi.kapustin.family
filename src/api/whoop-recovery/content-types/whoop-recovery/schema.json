{
  "kind": "collectionType",
  "collectionName": "whoop_recoveries",
  "info": {
    "singularName": "whoop-recovery",
    "pluralName": "whoop-recoveries",
    "displayName": "WHOOP Recovery",
    "description": "Восстановление WHOOP — HRV, пульс покоя, SpO2, температура"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "recoveryDate": {
      "type": "date",
      "required": true,
      "unique": true
    },
    "recoveryScore": {
      "type": "decimal",
      "required": true,
      "column": {
        "comment": "Recovery % (0-100)"
      }
    },
    "restingHeartRate": {
      "type": "decimal",
      "column": {
        "comment": "Пульс покоя (bpm)"
      }
    },
    "hrvRmssd": {
      "type": "decimal",
      "column": {
        "comment": "HRV RMSSD (ms)"
      }
    },
    "spo2": {
      "type": "decimal",
      "column": {
        "comment": "Сатурация кислорода %"
      }
    },
    "skinTempCelsius": {
      "type": "decimal",
      "column": {
        "comment": "Температура кожи °C"
      }
    },
    "recoveryZone": {
      "type": "enumeration",
      "enum": ["green", "yellow", "red"],
      "column": {
        "comment": "green 67-100, yellow 34-66, red 0-33"
      }
    },
    "whoopCycleId": {
      "type": "biginteger"
    }
  }
}
